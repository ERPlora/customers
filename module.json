  "queries": {
    "customers.list": {
      "permission": "customers.view_customer",
      "sql": "queries/list.sql",
      "list": {
        "search": [
          "name",
          "email",
          "phone",
          "tax_id",
          "company_name"
        ],
        "sort": [
          "id",
          "name",
          "email",
          "phone",
          "tax_id",
          "company_name",
          "lifecycle_stage",
          "source",
          "is_active",
          "total_purchases",
          "total_spent",
          "last_purchase_date"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "email": {
            "op": "like"
          },
          "phone": {
            "op": "like"
          },
          "tax_id": {
            "op": "range"
          },
          "company_name": {
            "op": "like"
          },
          "lifecycle_stage": {
            "op": "eq"
          },
          "source": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "total_purchases": {
            "op": "range"
          },
          "total_spent": {
            "op": "range"
          },
          "last_purchase_date": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all customers for the tenant"
      }
    },
    "customers.by_phone": {
      "permission": "customers.view_customer",
      "sql": "queries/by_phone.sql",
      "schema": "schemas/by_phone.json",
      "ai": {
        "description": "Finds the customers whose phone is the same number as `phone`, however either side was typed (spaces, dashes, +, 00, with or without the business's country code, keeping the leading 0 behind it where the country does, as Italian landlines; another country's code in front is somebody else)"
      }
    },
    "customers.get": {
      "permission": "customers.view_customer",
      "sql": "queries/get.sql",
      "schema": "schemas/get.json",
      "ai": {
        "description": "Retrieves a customer's details by their identifier"
      }
    },
    "customers.stats": {
      "permission": "customers.view_customer",
      "sql": "queries/stats.sql",
      "ai": {
        "description": "Returns aggregated customer statistics (totals, new customers, etc.)"
      }
    },
    "customers.groups.list": {
      "permission": "customers.view_customergroup",
      "sql": "queries/groups_list.sql",
      "list": {
        "search": [
          "name",
          "description",
          "customer_count"
        ],
        "sort": [
          "id",
          "name",
          "description",
          "color",
          "sort_order",
          "is_active",
          "customer_count"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "description": {
            "op": "like"
          },
          "color": {
            "op": "eq"
          },
          "sort_order": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "customer_count": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available customer groups"
      }
    },
    "customers.tags.list": {
      "permission": "customers.view_customertag",
      "sql": "queries/tags_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "color",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "color": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available customer tags"
      }
    },
    "customers.fields.list": {
      "permission": "customers.view_customer",
      "sql": "queries/fields_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "field_type",
          "options",
          "is_required",
          "sort_order",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "field_type": {
            "op": "eq"
          },
          "options": {
            "op": "eq"
          },
          "is_required": {
            "op": "eq"
          },
          "sort_order": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the custom fields defined for customers"
      }
    },
    "customers.fields.values": {
      "permission": "customers.view_customer",
      "sql": "queries/field_values.sql",
      "ai": {
        "description": "Custom field definitions with this customer's values (empty string when unset)"
      }
    },
    "customers.activities": {
      "permission": "customers.view_activity",
      "sql": "queries/activities.sql",
      "schema": "schemas/activities.json",
      "ai": {
        "description": "Lists the activity history of a customer"
      }
    },
    "customers.group_ids": {
      "permission": "customers.view_customer",
      "sql": "queries/group_ids.sql",
      "schema": "schemas/group_ids.json",
      "ai": {
        "description": "Lists the group ids assigned to a customer"
      }
    },
    "customers.tag_ids": {
      "permission": "customers.view_customer",
      "sql": "queries/tag_ids.sql",
      "schema": "schemas/tag_ids.json",
      "ai": {
        "description": "Lists the tag ids assigned to a customer"
      }
    },
    "customers.orders.by_customer": {
      "permission": "customers.view_customer",
      "expose_api": true,
      "sql": "queries/orders_by_customer.sql",
      "ai": {
        "description": "Lists the order ids linked to a customer (ADR-0141). Amounts come from sales via its declared query; customers stores only the FK."
      }
    },
    "customers.purchases": {
      "permission": "customers.view_customer",
      "sql": "queries/purchases.sql",
      "schema": "schemas/purchases.json",
      "list": {
        "search": [
          "source_id"
        ],
        "sort": [
          "created_at",
          "amount",
          "status",
          "source_type"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "status": {
            "op": "eq"
          },
          "source_type": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Paginated purchase history of a customer from the ledger (customers#8): source document (opaque sale id), amount in cents, currency, status confirmed|voided. Voided rows are kept."
      }
    },
    "customers.purchases.divergences": {
      "permission": "customers.view_customer",
      "sql": "queries/purchases_divergences.sql",
      "ai": {
        "description": "Reconciliation audit (customers#8): customers whose total_purchases/total_spent disagree with their purchase ledger. Empty = healthy."
      }
    },
    "customers.consent.state": {
      "permission": "customers.view_customer",
      "expose_api": true,
      "sql": "queries/consent_state.sql",
      "schema": "schemas/consent_state.json",
      "ai": {
        "description": "The EFFECTIVE marketing consent of a customer, one row per purpose and channel (customers#10): `granted`, `withdrawn` or `legacy_unverified` (a box ticked before the ledger existed — NEVER consent, EDPB 05/2020 §168). The last fact wins, so a withdrawal is in force on the next read. This is the door a marketing or messaging module asks before writing to anybody."
      }
    },
    "customers.consent.history": {
      "permission": "customers.view_customer",
      "sql": "queries/consent_history.sql",
      "schema": "schemas/consent_history.json",
      "ai": {
        "description": "Every consent fact of a customer, newest first (customers#10): what was decided, for what purpose and channel, at which address, from where, after which words and which version of them, backed by what, and who wrote it down. Append-only — a withdrawal is a row, never a deletion."
      }
    }
  },
  "commands": {
    "customers.create": {
      "permission": "customers.add_customer",
      "transaction": true,
      "sql": [
        "commands/create.sql"
      ],
      "schema": "schemas/create.json",
      "emit": [
        "customer.created"
      ],
      "ai": {
        "description": "Creates a new customer"
      }
    },
    "customers.update": {
      "permission": "customers.change_customer",
      "transaction": true,
      "sql": [
        "commands/update.sql"
      ],
      "schema": "schemas/update.json",
      "emit": [
        "customer.updated"
      ],
      "ai": {
        "description": "Updates an existing customer's data"
      }
    },
    "customers.update_with_fields": {
      "permission": "customers.change_customer",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_with_fields"
      },
      "schema": "schemas/update_with_fields.json",
      "reads": [
        {
          "query": "customers.fields.values",
          "params": {
            "customer_id": "payload.customer_id"
          },
          "required": true
        }
      ],
      "emit": [
        "customer.updated"
      ],
      "ai": {
        "description": "Updates a customer's sheet AND its custom-field values in one validated, atomic write (customers#13): required fields must end up filled, number/date/boolean/select values must match their type; any rejection reverts everything."
      }
    },
    "customers.consent.grant": {
      "permission": "customers.change_customer",
      "transaction": true,
      "sql": [
        "commands/consent_grant.sql",
        "commands/consent_sync_flag.sql",
        "commands/consent_activity.sql"
      ],
      "schema": "schemas/consent_grant.json",
      "emit": [
        "customer.consent_granted"
      ],
      "expect_rows": {
        "op": "min",
        "n": 3,
        "error": "customers.customer_unavailable",
        "message": "That customer is not available: it does not exist in this business or it has been deleted."
      },
      "ai": {
        "description": "Records that a customer GAVE consent, as an append-only fact with its evidence (customers#10): purpose, channel, the address it was given for, the source, the exact wording shown and its version, an optional external reference, when the person said it, and the hub user who wrote it down (taken from the session, never from the payload). Re-consenting after a withdrawal is a new fact, not an edit. The sheet's `marketing_consent`/`consent_date` are recomputed from the ledger, never set by hand."
      }
    },
    "customers.consent.withdraw": {
      "permission": "customers.change_customer",
      "transaction": true,
      "sql": [
        "commands/consent_withdraw.sql",
        "commands/consent_sync_flag.sql",
        "commands/consent_activity.sql"
      ],
      "schema": "schemas/consent_withdraw.json",
      "emit": [
        "customer.consent_withdrawn"
      ],
      "expect_rows": {
        "op": "min",
        "n": 3,
        "error": "customers.customer_unavailable",
        "message": "That customer is not available: it does not exist in this business or it has been deleted."
      },
      "ai": {
        "description": "Records that a customer WITHDREW consent for a purpose and channel (customers#10). A new fact: the grant it revokes stays, because the period during which writing to that person was lawful is what an inspection asks about. In force immediately — the next read of `customers.consent.state` already says no. The reason is optional: nobody has to justify saying no."
      }
    },
    "customers.delete": {
      "permission": "customers.delete_customer",
      "transaction": true,
      "schema": "schemas/delete.json",
      "sql": [
        "commands/delete.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "customers.customer_unavailable",
        "message": "That customer is not available: it does not exist in this business."
      },
      "emit": [
        "customer.deleted"
      ],
      "ai": {
        "description": "Deletes a customer (destructive)"
      }
    },
    "customers.anonymize": {
      "permission": "customers.erase_customer",
      "transaction": true,
      "sql": [
        "commands/anonymize.sql",
        "commands/anonymize_notes.sql",
        "commands/anonymize_activities.sql",
        "commands/anonymize_field_values.sql",
        "commands/anonymize_groups.sql",
        "commands/anonymize_tags.sql",
        "commands/anonymize_audit.sql",
        "commands/anonymize_consent.sql"
      ],
      "schema": "schemas/anonymize.json",
      "emit": [
        "customer.anonymized"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "customers.customer_unavailable",
        "message": "That customer is not available: it does not exist in this business."
      },
      "ai": {
        "description": "GDPR erasure (customers#11): replaces the customer's personal data by markers keeping the row id (sales/invoices keep their reference), blanks and soft-deletes notes, activities and custom-field values, drops group/tag membership and writes ONE `erased` audit entry (actor, reason, scope). Irreversible. The purchase ledger is retained. Idempotent and hub-scoped."
      }
    },
    "customers.merge": {
      "permission": "customers.merge_customer",
      "transaction": true,
      "schema": "schemas/merge.json",
      "sql": [
        "commands/merge.sql",
        "commands/merge_notes.sql",
        "commands/merge_activities.sql",
        "commands/merge_field_values_fill.sql",
        "commands/merge_field_values_move.sql",
        "commands/merge_groups_add.sql",
        "commands/merge_groups_clear.sql",
        "commands/merge_tags_add.sql",
        "commands/merge_tags_clear.sql",
        "commands/merge_purchase_ledger.sql",
        "commands/merge_customer_order.sql",
        "commands/merge_consent_ledger.sql",
        "commands/merge_consent_sync_flag.sql",
        "commands/merge_audit.sql",
        "commands/merge_retire.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "statement": "commands/merge.sql",
        "error": "customers.customer_unavailable",
        "message": "Those customers cannot be merged: both must exist in this business, be different and not deleted."
      },
      "emit": [
        "customer.merged"
      ],
      "ai": {
        "description": "Merges a duplicate customer sheet (absorbed_id) into the surviving one (surviving_id): the survivor keeps its own data and only fills its EMPTY fields from the absorbed sheet, notes are appended and totals summed. Everything else that hangs off the absorbed sheet moves to the survivor: notes, timeline, custom-field values, groups/tags, purchase ledger, order links and consent facts. The absorbed sheet is retired (soft-deleted, never physically removed). Emits customer.merged {surviving_id, absorbed_id} so other modules can re-point their own rows. Irreversible; hub-scoped."
      }
    },
    "customers.record_purchase": {
      "permission": "customers.change_customer",
      "transaction": true,
      "sql": [
        "commands/record_purchase.sql",
        "commands/record_purchase_activity.sql"
      ],
      "schema": "schemas/record_purchase.json",
      "ai": {
        "description": "Records a purchase in the customer's history: ONE idempotent ledger row per (hub, source_type, source_id) — the same sale delivered twice moves the totals once — plus the aggregate update and a `purchase` timeline entry (customers#8)."
      },
      "internal": true
    },
    "customers._reverse_purchase": {
      "permission": "customers.change_customer",
      "transaction": true,
      "sql": [
        "commands/_reverse_purchase.sql",
        "commands/_reverse_purchase_activity.sql"
      ],
      "ai": {
        "description": "Listener of sale.voided (customers#8): flips the ledger row to voided (history kept), reverts amount/count/last purchase, steps the stage back deterministically and writes a `purchase_voided` timeline entry. Idempotent."
      }
    },
