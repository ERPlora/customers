    "name": { "type": "string", "minLength": 1 },
    "field_type": { "type": "string", "enum": ["text", "number", "date", "boolean", "select", "textarea"] },
    "options": { "type": "string", "description": "JSON array serializado (opciones de select), p.ej. '[]'" },
    "is_required": { "type": ["boolean", "integer"], "minimum": 0, "maximum": 1 },
    "sort_order": { "type": "integer", "minimum": 0 } } }
