{ "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customers.create payload", "type": "object", "additionalProperties": true,
  "comment": "Alta rápida de walk-in: solo `name` es obligatorio. El resto son opcionales con `default` para que, si el caller los omite, el runtime los inyecte antes de bindear (causa raíz decision-log 2026-06-25) y no peten las columnas NOT NULL DEFAULT del esquema (migrations/001). `additionalProperties:true` conserva los campos custom.",
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "anyOf": [ { "format": "email" }, { "const": "" } ], "default": "" },
    "phone": { "type": "string", "default": "" },
    "tax_id": { "type": "string", "default": "" },
    "address": { "type": "string", "default": "" },
    "city": { "type": "string", "default": "" },
    "postal_code": { "type": "string", "default": "" },
    "country": { "type": "string", "default": "" },
    "avatar": { "type": "string", "default": "" },
    "notes": { "type": "string", "default": "" },
    "lifecycle_stage": { "type": "string",
      "enum": ["lead", "prospect", "first_purchase", "active", "at_risk", "dormant", "churned", "vip"],
      "default": "lead" },
    "source": { "type": "string", "default": "walk_in" },
    "company_name": { "type": "string", "default": "" },
    "birthday": { "type": ["string", "null"], "default": null },
    "anniversary": { "type": ["string", "null"], "default": null },
    "preferred_channel": { "type": "string", "enum": ["email", "sms", "whatsapp", "phone", "none"], "default": "none" },
    "marketing_consent": { "type": ["boolean", "integer"], "minimum": 0, "maximum": 1, "default": 0 },
    "consent_date": { "type": ["string", "null"], "default": null } } }
