{ "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customers.update payload", "type": "object", "additionalProperties": true,
  "required": ["customer_id", "name", "email", "phone", "tax_id", "address", "city", "postal_code",
               "country", "notes", "lifecycle_stage", "source", "company_name", "birthday",
               "anniversary", "preferred_channel", "marketing_consent", "is_active"],
  "properties": {
    "customer_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "anyOf": [ { "format": "email" }, { "const": "" } ] },
    "phone": { "type": "string" },
    "tax_id": { "type": "string" },
    "address": { "type": "string" },
    "city": { "type": "string" },
    "postal_code": { "type": "string" },
    "country": { "type": "string" },
    "notes": { "type": "string" },
    "lifecycle_stage": { "type": "string",
      "enum": ["lead", "prospect", "first_purchase", "active", "at_risk", "dormant", "churned", "vip"] },
    "source": { "type": "string" },
    "company_name": { "type": "string" },
    "birthday": { "type": ["string", "null"] },
    "anniversary": { "type": ["string", "null"] },
    "preferred_channel": { "type": "string", "enum": ["email", "sms", "whatsapp", "phone", "none"] },
    "marketing_consent": { "type": ["boolean", "integer"], "minimum": 0, "maximum": 1 },
    "is_active": { "type": ["boolean", "integer"], "minimum": 0, "maximum": 1 } } }
