{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customers.update_with_fields payload",
  "type": "object",
  "additionalProperties": true,
  "description": "The full customer sheet (same binds as customers.update) plus `fields`: the custom-field values to write. The handler validates every value against the field definition (type/options/required) BEFORE any write; the whole command reverts on the first rejection (customers#13).",
  "required": [
    "customer_id",
    "name",
    "email",
    "phone",
    "tax_id",
    "address",
    "city",
    "postal_code",
    "country",
    "notes",
    "lifecycle_stage",
    "source",
    "company_name",
    "birthday",
    "anniversary",
    "preferred_channel",
    "is_active",
    "fields"
  ],
  "properties": {
    "customer_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "anyOf": [
        {
          "format": "email"
        },
        {
          "const": ""
        }
      ]
    },
    "phone": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "lead",
        "prospect",
        "first_purchase",
        "active",
        "at_risk",
        "dormant",
        "churned",
        "vip"
      ]
    },
    "source": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "birthday": {
      "type": [
        "string",
        "null"
      ]
    },
    "anniversary": {
      "type": [
        "string",
        "null"
      ]
    },
    "preferred_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "whatsapp",
        "phone",
        "none"
      ]
    },
    "marketing_consent": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1,
      "deprecated": true,
      "description": "IGNORED since customers#10 — same as in `customers.update`, whose binds this forwards. Consent is an append-only fact with its evidence (`customers.consent.grant` / `customers.consent.withdraw`); `marketing_consent`/`consent_date` are recomputed from that ledger. Accepted so callers that already send it do not break."
    },
    "is_active": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "fields": {
      "type": "array",
      "maxItems": 200,
      "description": "Values to write. A field not listed keeps its stored value. Empty string clears an optional field.",
      "items": {
        "type": "object",
        "required": [
          "field_id",
          "value"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "description": "TEXT for every type: number = decimal, date = YYYY-MM-DD, boolean = 1/0, select = one of the field's options."
          }
        }
      }
    }
  }
}
